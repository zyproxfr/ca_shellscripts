# Copier ce fichier en .env et adapter les valeurs avant le premier lancement.
# Ne jamais committer le fichier .env réel (secrets, mots de passe).

# Postgres (docker-compose fournit ces valeurs par défaut en local)
POSTGRES_USER=dart_app
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=dart_tournaments
DATABASE_URL="postgresql://dart_app:change_me_in_production@localhost:5432/dart_tournaments?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Générer une vraie valeur avec: openssl rand -base64 32
NEXTAUTH_SECRET="change_me_generate_a_real_secret"

# Port du serveur HTTP custom (Next.js + Socket.io)
PORT=3000
